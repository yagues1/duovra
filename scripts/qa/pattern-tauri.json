{
  "productName": "Duovra Patrones QA",
  "identifier": "dev.duovra.studio.qa.pattern",
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "pattern-qa-window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:window:allow-set-size",
            "core:window:allow-unminimize",
            "core:window:allow-set-focus"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Duovra Patrones QA",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#14151A",
        "center": true,
        "dragDropEnabled": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  }
}